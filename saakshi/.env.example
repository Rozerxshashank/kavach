# Gnani Vachana speech (required): Timbre (TTS) and Prisma (STT) share this key
GNANI_API_KEY=
GNANI_TTS_ENDPOINT=https://api.vachana.ai/api/v1/tts/inference
GNANI_ASR_ENDPOINT=https://api.vachana.ai/stt/v3
GNANI_TTS_MODEL=timbre-v2.5

# Reasoning models via Groq (required)
GROQ_API_KEY=
SAAKSHI_AGENT_MODEL=openai/gpt-oss-120b
SAAKSHI_FAST_MODEL=openai/gpt-oss-20b

# Signs logins and Kaam Passports. Required in production, 32+ random characters:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SAAKSHI_SIGNING_KEY=

# --- Real phone calls (optional) ------------------------------------------------
# Leave empty to run calls in the browser. Fill all four to dial real numbers
# and to open a hotline workers can call from any phone.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# The public HTTPS address of this server (required in production; WhatsApp links use it)
SAAKSHI_PUBLIC_URL=

# --- Access -------------------------------------------------------------------
# The operator key for the witness desk (16+ random characters). Required in production.
# Without it (local development only), the desk and every worker's data are open.
# Demo data (the seeded workers, red-team runs) is open to visitors either way.
SAAKSHI_ADMIN_KEY=

# "production" makes the server refuse to start without the secrets above, turns off
# the API docs and open CORS, and trusts the hosting proxy for visitor addresses.
# The Docker image sets it for you.
SAAKSHI_ENV=development
# docker-compose only: the domain Caddy gets an HTTPS certificate for, e.g. 203.0.113.7.sslip.io
SAAKSHI_DOMAIN=
