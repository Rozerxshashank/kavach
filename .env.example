# One .env for both apps (Kavach and Saakshi read it).
# Generate secrets with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# --- shared services (required) ---
GNANI_API_KEY=
GROQ_API_KEY=

# --- deployment: one hostname per app (sslip.io works without buying a domain) ---
# e.g. kavach.203.0.113.7.sslip.io and saakshi.203.0.113.7.sslip.io
KAVACH_DOMAIN=
SAAKSHI_DOMAIN=

# --- Kavach ---
# 32+ random characters
KAVACH_SIGNING_KEY=
# 16+ random characters: the operator key (promote fixes, manage Shield keys)
KAVACH_ADMIN_KEY=
# attack calls per day across all visitors (protects the speech and model quotas)
KAVACH_DAILY_ATTACKS=40

# --- Saakshi ---
SAAKSHI_SIGNING_KEY=
SAAKSHI_ADMIN_KEY=

# --- Kavach <-> Saakshi ---
# 24+ random characters, the same for both: lets Kavach run sandboxed test calls on Saakshi
SAAKSHI_HARNESS_KEY=
# create it in Kavach (Shield page, as operator) for the policy saakshi-employer-calls
KAVACH_SHIELD_KEY=
# real calls go through Kavach Shield (Saakshi fails safe to its own rules if Kavach is down)
SAAKSHI_SHIELD=on
