# --- Gnani Vachana speech (required) -------------------------------------------
# Timbre (TTS) and Prisma (STT) both use this key.
GNANI_API_KEY=
GNANI_TTS_ENDPOINT=https://api.vachana.ai/api/v1/tts/inference
GNANI_ASR_ENDPOINT=https://api.vachana.ai/stt/v3
GNANI_TTS_MODEL=timbre-v2.5

# --- Reasoning models via Groq (required) ---------------------------------------
GROQ_API_KEY=
KAVACH_ATTACKER_MODEL=openai/gpt-oss-120b
KAVACH_BOT_MODEL=openai/gpt-oss-20b
KAVACH_JUDGE_MODEL=openai/gpt-oss-120b
